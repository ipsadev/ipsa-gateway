# The api the gateway reads Stellar and the Cosmos Hub through
STELLAR_API_URL=http://127.0.0.1:8101

# Where the gateway's gRPC service binds
STELLAR_GATEWAY_HOST=0.0.0.0
STELLAR_GATEWAY_GRPC_PORT=50052

# The chains it relays between
STELLAR_CHAIN_ID=stellar-testnet
COSMOS_CHAIN_ID=simd-1

# The deployment's Soroban contracts
ROUTER_CONTRACT_ADDRESS=
TRANSFER_CONTRACT_ADDRESS=

# The read-only Stellar account transactions are built for; it signs and pays nothing
STELLAR_SOURCE_ACCOUNT=

# The Cosmos account Hub messages are built for; the relayer signs them with its own key
COSMOS_RELAYER_ADDRESS=

# How far back, in ledgers (about a day by default), a relay searches the router's events for a packet
RELAY_EVENT_LOOKBACK_LEDGERS=17280

# How often, in seconds, the gateway follows the router's new ledgers into its state tree; 0 turns it off
GATEWAY_FOLLOW_SECONDS=60

# The ledger the router was deployed at, where a replay without a snapshot starts
ROUTER_GENESIS_LEDGER=

# Where the gateway saves its state tree (Postgres). Empty keeps it in memory.
GATEWAY_DB_URL=

# Extra root certificates for the Postgres connection, such as Amazon's RDS bundle. Empty trusts the web roots only.
PGSSLROOTCERT=
